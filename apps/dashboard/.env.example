# Supabase — copy this file to .env.local and fill in your project's values.
# Find both in the Supabase dashboard: Project Settings -> API.
# (NEXT_PUBLIC_ vars are exposed to the browser; the anon key is safe to expose.)

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service-role secret — SERVER ONLY, never expose to the browser (no NEXT_PUBLIC_).
# Used by the admin dashboard to manage/delete users. Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
